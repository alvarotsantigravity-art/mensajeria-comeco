{
  "name": "mensajeria-comeco",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "create-admin": "node --env-file=.env.local scripts/create-admin.mjs",
    "reset-password": "node --env-file=.env.local scripts/reset-password.mjs",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:types": "npx supabase gen types typescript --linked --schema public > lib/supabase/database.types.ts",
    "test:rls": "node --env-file=.env.local --test tests/rls/rls.test.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
